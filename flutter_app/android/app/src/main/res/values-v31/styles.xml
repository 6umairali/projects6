<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ONE splash for every Android version (androidx core-splashscreen): brand colour + logo/name, kept on screen
         until the app has drawn its first real screen. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_symbol</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <!-- Behind the Flutter UI once it is running. AppCompat parent is required by the fingerprint / face prompt. -->
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
