APP_NAME=MailTrixy
APP_ENV=production
APP_KEY=
# IMPORTANT: Keep APP_DEBUG=false in production. Setting to true exposes sensitive data.
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=error

# =============================================================================
# DATABASE — MySQL (shared hosting: get from cPanel → MySQL Databases)
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# =============================================================================
# DRIVERS — Shared hosting compatible (no Redis needed)
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=file
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# =============================================================================
# AUTOMATION — Plug & Play background processing
# =============================================================================
# Mode: 'middleware' (no cron needed), 'queue' (needs supervisor), 'scheduler' (needs cron)
AUTOMATION_MODE=middleware
AUTOMATION_MIDDLEWARE_ENABLED=true
AUTOMATION_THROTTLE=60
AUTOMATION_MAX_JOBS=3
AUTOMATION_MAX_SECONDS=5
AUTOMATION_EMAIL_SYNC=true
AUTOMATION_EMAIL_SYNC_INTERVAL=3
AUTOMATION_OAUTH_REFRESH=true
AUTOMATION_QUEUE_PROCESSING=true
AUTOMATION_DRIP_PROCESSING=true
AUTOMATION_SCHEDULED_EMAILS=true

# =============================================================================
# SANCTUM — API token settings
# =============================================================================
SANCTUM_TOKEN_PREFIX=mb_

# =============================================================================
# MAIL — Transactional emails (verification, password reset, notifications)
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# OAUTH SOCIAL LOGIN (optional — get from each provider's developer console)
# =============================================================================
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Microsoft: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# =============================================================================
# AI PROVIDERS (at least one required for AI features)
# =============================================================================
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Mistral: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# =============================================================================
# VECTOR STORE — Pinecone (optional free tier, falls back to MySQL FULLTEXT)
# =============================================================================
# Pinecone: https://app.pinecone.io/
PINECONE_API_KEY=
PINECONE_HOST=

# =============================================================================
# CHANNELS (all optional — enable as needed)
# =============================================================================
# WhatsApp: https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Twilio: https://console.twilio.com/
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Slack: https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI="${APP_URL}/integrations/slack/callback"

# =============================================================================
# INTEGRATIONS — CRM, Calendar, Automation
# =============================================================================
# Salesforce: https://developer.salesforce.com/
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI="${APP_URL}/integrations/salesforce/callback"
SALESFORCE_INSTANCE_URL=

# HubSpot: https://app.hubspot.com/private-apps/
HUBSPOT_API_KEY=

# Google Calendar: https://console.cloud.google.com/apis/credentials
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/integrations/google-calendar/callback"

# =============================================================================
# STRIPE — Payments (required for paid plans)
# =============================================================================
# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd

# =============================================================================
# PUSHER — Live Chat only (optional free tier)
# =============================================================================
# Pusher: https://dashboard.pusher.com/
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# =============================================================================
# HCAPTCHA (optional — for bot protection on registration)
# =============================================================================
# hCaptcha: https://dashboard.hcaptcha.com/
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# =============================================================================
# FILE STORAGE — Local by default. Uncomment for S3.
# =============================================================================
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# =============================================================================
# SECURITY — DDoS protection, honeypot, API hardening
# =============================================================================
SECURITY_TRUSTED_IPS=
SECURITY_TRUST_PROXY=false
SECURITY_MAX_RPM=200
SECURITY_API_MAX_RPM=50
SECURITY_HONEYPOT=true
SECURITY_SCANNER_THRESHOLD=10
SECURITY_API_MAX_BODY=10485760

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Web realtime: Pusher or a compatible WebSocket server; polling remains a fallback.
# PUSHER_HOST=api-mt1.pusher.com
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# Custom browser WebSocket endpoint (leave host unset for hosted Pusher):
# PUSHER_WS_HOST=ws.example.com
PUSHER_WS_PORT=443
PUSHER_WS_SCHEME=https

# Mobile background push: required independently of browser WebSockets.
# Download the service-account JSON from the SAME Firebase project as the app.
# Store it outside public/, readable by PHP. Never commit the key.
FIREBASE_CREDENTIALS=
# Native iOS incoming calls also require an Apple APNs signing key.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.dahify.dahimail
# After changing .env: php artisan config:cache && php artisan push:status
